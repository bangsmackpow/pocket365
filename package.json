{
  "name": "pocket365",
  "version": "1.0.0",
  "private": true,
  "description": "Pocket365 — Cloudflare-native Microsoft 365 & Entra ID management console (Self-Hosted & SaaS)",
  "repository": {
    "type": "git",
    "url": "https://github.com/bangsmackpow/pocket365.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply pocket365-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply pocket365-db --remote",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.7",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.18",
    "lucide-react": "^1.80.0",
    "nitro": "^3.0.261103-rc",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
