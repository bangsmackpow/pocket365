# ==============================================================================
# Pocket365 Configuration (Cloudflare Workers — Local .dev.vars or CF Secrets)
# Copy this file to .dev.vars for `wrangler dev`, or set secrets via:
#   npx wrangler secret put <KEY>
# ==============================================================================

# Deployment Mode:
#   self_hosted (default) — Single-tenant deployment on your own Cloudflare account
#   saas                  — Multi-tenant SaaS mode with organization isolation
DEPLOYMENT_MODE=self_hosted

# Canonical external URL (no trailing slash). Used for OIDC redirect URI:
#   ${APP_BASE_URL}/api/auth/callback
APP_BASE_URL=https://pocket365.example.com

# Single-Tenant Microsoft Entra ID (required in self_hosted mode; optional in saas mode)
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Interactive User Login (Entra ID OIDC Web App Registration)
OIDC_CLIENT_ID=00000000-0000-0000-0000-000000000000
OIDC_CLIENT_SECRET=replace-with-oidc-client-secret

# Session Signing & Encryption Secrets (generate each with: openssl rand -hex 32)
SESSION_SECRET=replace-with-at-least-32-character-random-hex-secret
DATA_ENCRYPTION_KEY=replace-with-64-char-hex-aes-256-gcm-key
# Optional one-time bootstrap secret protecting the /setup wizard on first run
# SETUP_BOOTSTRAP_TOKEN=

# Session & Network Security
SESSION_TTL_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=120
TRUSTED_PROXY_HOPS=1
# Set true ONLY if delivering webhooks to a private relay (disables SSRF private-IP block)
# ALLOW_PRIVATE_WEBHOOKS=false

# Role-Based Access Control (RBAC — self_hosted mode)
# Comma-separated Entra Object IDs (oid), UPNs (user@domain.com), or Security Group Object IDs.
# Role hierarchy: owner > admin > helpdesk > security_auditor > viewer.
# OWNER_OIDS_OR_GROUPS=
ADMIN_OIDS_OR_GROUPS=admin@contoso.com,11111111-1111-1111-1111-111111111111
# HELPDESK_OIDS_OR_GROUPS=
# AUDITOR_OIDS_OR_GROUPS=
VIEWER_OIDS_OR_GROUPS=22222222-2222-2222-2222-222222222222

# Microsoft Graph App-Only (Client Credentials)
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Option A: Client Secret authentication
GRAPH_CLIENT_SECRET=replace-with-graph-client-secret

# Option B: X.509 Certificate authentication (recommended; takes precedence over client secret)
# SHA-1 certificate thumbprint (40 hex characters, without colons or spaces)
# GRAPH_CERT_THUMBPRINT=
# PEM-encoded RSA private key (inline with \n escapes; store via `wrangler secret put`)
# GRAPH_CERT_PRIVATE_KEY=

# Optional: Graph API retry tuning
# GRAPH_MAX_RETRIES=4
# GRAPH_BASE_BACKOFF_MS=1000

# Commercial Tiering & Licensing
# LICENSE_ENFORCEMENT=off (open self-hosted) | strict (enforce Free/Pro/SaaS tiers)
# LICENSE_ENFORCEMENT=off
# POCKET365_TIER=community
# Ed25519 SPKI PEM public key for verifying offline signed license keys (inline \n escapes)
# LICENSE_PUBLIC_KEY=

# Stripe Billing & SaaS Checkout
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_SAAS=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_ENTERPRISE=price_...
