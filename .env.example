# ==============================================================================
# Pocket365 Configuration
# Copy this file to .env for local development or configure in Portainer Stack
# ==============================================================================

# Server & Reverse Proxy
PORT=3000
HOST=0.0.0.0
# Canonical external URL (no trailing slash). Used for OIDC redirect URI:
#   ${APP_BASE_URL}/api/auth/callback
# In production behind Nginx Proxy Manager, use https://pocket365.example.com
APP_BASE_URL=http://localhost:3000

# Persistence (use /data in Docker/Portainer; defaults to ./data in local dev)
DATA_DIR=./data

# Single-Tenant Microsoft Entra ID
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Interactive User Login (Entra ID OIDC Web App Registration)
OIDC_CLIENT_ID=00000000-0000-0000-0000-000000000000
OIDC_CLIENT_SECRET=replace-with-oidc-client-secret

# Session Signing & Security (generate with: openssl rand -hex 32)
SESSION_SECRET=replace-with-at-least-32-character-random-hex-secret
# Optional session lifetime in hours (default: 12)
SESSION_TTL_HOURS=12

# Role-Based Access Control (RBAC)
# Comma-separated Entra Object IDs (oid), UPNs (user@domain.com), or Security Group Object IDs.
# Users not matching either list are strictly rejected.
ADMIN_OIDS_OR_GROUPS=admin@contoso.com,11111111-1111-1111-1111-111111111111
VIEWER_OIDS_OR_GROUPS=22222222-2222-2222-2222-222222222222

# Microsoft Graph App-Only (Client Credentials)
# Can reuse OIDC_CLIENT_ID if the same app registration has Graph Application permissions,
# or use a dedicated Graph daemon App Registration (recommended).
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Option A: Client Secret authentication
GRAPH_CLIENT_SECRET=replace-with-graph-client-secret

# Option B: X.509 Certificate authentication (takes precedence when both thumbprint & key are set)
# SHA-1 certificate thumbprint (40 hex characters, without colons or spaces)
# GRAPH_CERT_THUMBPRINT=
# PEM-encoded RSA private key (inline with \n escapes) OR path to mounted PEM file
# GRAPH_CERT_PRIVATE_KEY=
# GRAPH_CERT_PRIVATE_KEY_PATH=/run/secrets/graph_private_key.pem

# Optional: Graph API retry tuning
# GRAPH_MAX_RETRIES=4
# GRAPH_BASE_BACKOFF_MS=1000
